{
  "manifest_version": 3,
  "name": "Profile Switcher",
  "version": "1.2.0",
  "description": "Switch between accounts instantly via a cookies snapshot. All data is stored locally in your browser.",

  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "browsingData"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "incognito": "spanning",

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Buka Profile Switcher"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}